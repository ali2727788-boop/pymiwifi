import requests
from pymiwifi import MiWiFi

# 1. الاتصال بالراوتر بالكلمة التي تعرفها بعد الـ Reset
router_ip = "10.2.134.254" # أو 192.168.31.1 حسب جهازك
admin_password = "كلمة_مرور_المسؤول_الجديدة"

miwifi = MiWiFi(router_ip)
miwifi.login(admin_password) # تسجيل الدخول البرمجي بنجاح

# 2. إرسال أمر برمي لتعديل بيانات الواي فاي (الاسم وكلمة المرور)
# يتم استخدام الرابط الداخلي للراوتر المسؤول عن تعديل الواي فاي xqnetwork/set_wifi
payload = {
    'ssid': 'اسم_الشبكة_الجديد',
    'password': 'كلمة_سر_الواي_فاي_الجديدة',
    'encryption': 'WPA2PSK' # نوع التشفير
}

# إرسال الطلب البرمجي للراوتر لتنفيذ التعديل فوراً
response = miwifi.get_api_endpoint('xqnetwork/set_wifi', data=payload)

print("تم تعديل البيانات بنجاح!")
miwifi.logout()
